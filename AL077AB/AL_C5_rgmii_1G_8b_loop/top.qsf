set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEFA5U19C8
set_global_assignment -name TOP_LEVEL_ENTITY top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 20.1.1
set_global_assignment -name PROJECT_CREATION_TIME_DATE "00:01:53  JUNE 19, 2025"
set_global_assignment -name LAST_QUARTUS_VERSION "20.1.1 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 484
set_global_assignment -name DEVICE_FILTER_SPEED_GRADE 8
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top


set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
set_global_assignment -name VERILOG_SHOW_LMF_MAPPING_MESSAGES OFF

set_location_assignment PIN_Y10 -to i_rst_n

set_location_assignment PIN_A22 -to i_uart_rx
set_location_assignment PIN_B22 -to o_uart_tx

set_location_assignment PIN_W8 -to o_rgmii_rst_n
# AL077AB IC2 Close to Edge
# set_location_assignment PIN_AB17 -to i_rgmii_rxc
# set_location_assignment PIN_Y16 -to i_rgmii_rxctl
# set_location_assignment PIN_Y17 -to i_rgmii_rxd[0]
# set_location_assignment PIN_Y15 -to i_rgmii_rxd[1]
# set_location_assignment PIN_Y14 -to i_rgmii_rxd[2]
# set_location_assignment PIN_AB16 -to i_rgmii_rxd[3]
# set_location_assignment PIN_W13 -to o_rgmii_txc
# set_location_assignment PIN_Y12 -to o_rgmii_txctl
# set_location_assignment PIN_AA15 -to o_rgmii_txd[0]
# set_location_assignment PIN_AB15 -to o_rgmii_txd[1]
# set_location_assignment PIN_AB13 -to o_rgmii_txd[2]
# set_location_assignment PIN_W12 -to o_rgmii_txd[3]
# # AL077AB IC1 Close to USB
set_location_assignment PIN_AA10 -to i_rgmii_rxc
set_location_assignment PIN_V9 -to i_rgmii_rxctl
set_location_assignment PIN_AB11 -to i_rgmii_rxd[0]
set_location_assignment PIN_AB10 -to i_rgmii_rxd[1]
set_location_assignment PIN_AA9 -to i_rgmii_rxd[2]
set_location_assignment PIN_AB8 -to i_rgmii_rxd[3]
set_location_assignment PIN_AA7 -to o_rgmii_txc
set_location_assignment PIN_Y7 -to o_rgmii_txctl
set_location_assignment PIN_AA8 -to o_rgmii_txd[0]
set_location_assignment PIN_AB7 -to o_rgmii_txd[1]
set_location_assignment PIN_Y9 -to o_rgmii_txd[2]
set_location_assignment PIN_W7 -to o_rgmii_txd[3]

set_global_assignment -name DEVICE_FILTER_PACKAGE UFBGA
set_global_assignment -name ENABLE_SIGNALTAP ON
set_global_assignment -name USE_SIGNALTAP_FILE src/stp1.stp
set_global_assignment -name SYSTEMVERILOG_FILE src/udp/udp_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/udp/tx_mux.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/udp/rx_mux.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/udp/icmp.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/udp/gmii2rgmii.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/udp/gmii_tx.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/udp/gmii_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/udp/gmii_rx.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/udp/arp.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/uart/uart_tx.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/uart/uart_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/uart/uart_rx.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/top.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/test_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/loop_top.sv
set_global_assignment -name SIP_FILE src/ip/rx_clk_pll.sip
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top