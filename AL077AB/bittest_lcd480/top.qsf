set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEFA5U19C8
set_global_assignment -name TOP_LEVEL_ENTITY top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 20.1.1
set_global_assignment -name PROJECT_CREATION_TIME_DATE "22:27:27  AUGUST 25, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "20.1.1 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256

# -------------------------------------------------------------------------- #
# 源文件
# -------------------------------------------------------------------------- #

# -------------------------------------------------------------------------- #
# 系统时钟（AL077AB 25MHz 晶振）
# -------------------------------------------------------------------------- #
set_location_assignment PIN_K7 -to i_clk

# -------------------------------------------------------------------------- #
# LCD 引脚（top.sv 与源工程保持一致，直接在 QSF 约束原端口名）
# 物理位置对应 AL077AB CD 扩展口1：o_exter_io1[0..27]
# -------------------------------------------------------------------------- #
set_location_assignment PIN_Y11 -to o_lcd_rgb[16]
set_location_assignment PIN_U10 -to o_lcd_rgb[17]
set_location_assignment PIN_U15 -to o_lcd_rgb[18]
set_location_assignment PIN_V15 -to o_lcd_rgb[19]
set_location_assignment PIN_U17 -to o_lcd_rgb[20]
set_location_assignment PIN_U16 -to o_lcd_rgb[21]
set_location_assignment PIN_V18 -to o_lcd_rgb[22]
set_location_assignment PIN_W18 -to o_lcd_rgb[23]
set_location_assignment PIN_V20 -to o_lcd_rgb[8]
set_location_assignment PIN_V19 -to o_lcd_rgb[9]
set_location_assignment PIN_T18 -to o_lcd_rgb[10]
set_location_assignment PIN_T17 -to o_lcd_rgb[11]
set_location_assignment PIN_R17 -to o_lcd_rgb[12]
set_location_assignment PIN_R16 -to o_lcd_rgb[13]
set_location_assignment PIN_P19 -to o_lcd_rgb[14]
set_location_assignment PIN_R19 -to o_lcd_rgb[15]
set_location_assignment PIN_P14 -to o_lcd_rgb[0]
set_location_assignment PIN_R14 -to o_lcd_rgb[1]
set_location_assignment PIN_M17 -to o_lcd_rgb[2]
set_location_assignment PIN_M16 -to o_lcd_rgb[3]
set_location_assignment PIN_K15 -to o_lcd_rgb[4]
set_location_assignment PIN_L15 -to o_lcd_rgb[5]
set_location_assignment PIN_K17 -to o_lcd_rgb[6]
set_location_assignment PIN_L17 -to o_lcd_rgb[7]
set_location_assignment PIN_L20 -to o_lcd_clk
set_location_assignment PIN_L19 -to o_lcd_hs
set_location_assignment PIN_K19 -to o_lcd_vs
set_location_assignment PIN_L18 -to o_lcd_de

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name SYSTEMVERILOG_FILE src/top.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/rgb_timing.sv
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name QIP_FILE src/ip/video_pll.qip
set_global_assignment -name SIP_FILE src/ip/video_pll.sip
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top